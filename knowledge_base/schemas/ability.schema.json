{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Video Ability",
  "type": "object",
  "required": [
    "ability_id",
    "name",
    "category",
    "status",
    "stages",
    "summary",
    "template",
    "source_case_urls"
  ],
  "properties": {
    "ability_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "seed",
        "observing",
        "solidified",
        "deprecated"
      ]
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "template": {
      "type": "string",
      "minLength": 1
    },
    "source_case_urls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
