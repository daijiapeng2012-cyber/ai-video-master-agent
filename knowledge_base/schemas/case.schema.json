{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Video Case",
  "type": "object",
  "required": [
    "title",
    "source",
    "url",
    "published_at",
    "captured_date",
    "content_types",
    "stages",
    "credibility",
    "summary",
    "template",
    "evidence_boundary"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "published_at": {
      "type": "string"
    },
    "captured_date": {
      "type": "string"
    },
    "content_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "credibility": {
      "type": "string",
      "enum": [
        "高",
        "中高",
        "中",
        "低"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "template": {
      "type": "string",
      "minLength": 1
    },
    "ability_links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_boundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
